int longeststr(string s)
    {
        Dictionary<char,int>dt=new Dictionary<char,int>();
        int left=0;
        int maxlen=0;
        for(int right=0;right<s.Length;right++)
        {
            if(!dt.ContainsKey(s[right]))
                dt[s[right]]=0;
                dt[s[right]]++;
                
            while(dt[s[right]]>1)
            {
            dt[s[left]]--;
            left++;
            }
        
            maxlen=Math.Max(maxlen,right-left+1);
          
        }
       
        return maxlen;
        
    }
}
